#!/usr/bin/env bash
set -euo pipefail

# SSH tunnel helpers for the dev/prod scraper.
#
# REVERSE SOCKS proxy (-R): remote scraper routes outbound HTTP through this
# machine's residential IP, dodging datacenter IP blocks on jobstreet/glints/
# linkedin. The scraper reads `socks5://localhost:1080` from SCRAPER_PROXY_URL;
# scraper-mcp runs `network_mode: host`, so remote :1080 = this tunnel.
#
# FORWARD mongo tunnel (-L): forwards local :MONGO_PORT to remote
# 127.0.0.1:27017 so you can connect to prod MongoDB from this machine.
#
# Setup:
#   1. cp scripts/ssh-tunnel.sh.example scripts/ssh-tunnel.sh
#   2. Set SSH_HOST / SSH_USER below (or export them as env vars).
#   3. ssh-tunnel.sh is git-ignored — the real host/user stay local.
#
# Usage:
#   ./scripts/ssh-tunnel.sh up         # open the reverse SOCKS proxy
#   ./scripts/ssh-tunnel.sh down       # close it
#   ./scripts/ssh-tunnel.sh status     # proxy + mongo tunnel liveness + docker ps
#   ./scripts/ssh-tunnel.sh test       # verify remote egress exits via this machine
#   ./scripts/ssh-tunnel.sh mongo-up     # forward local :MONGO_PORT → remote mongo
#   ./scripts/ssh-tunnel.sh mongo-down   # close the mongo forward tunnel
#   ./scripts/ssh-tunnel.sh mongo-status # show mongo tunnel liveness
#   ./scripts/ssh-tunnel.sh mongo-test   # verify port reachable + mongosh ping
#   ./scripts/ssh-tunnel.sh mongo-reset  # reset remote mongo root password to MONGO_ROOT_PASSWORD

SSH_HOST="${SSH_HOST:-YOUR_SERVER_IP}"
SSH_USER="${SSH_USER:-YOUR_SSH_USER}"
SSH_KEY="${SSH_KEY:-}"
PROXY_PORT="${PROXY_PORT:-1080}" # Check this against SCRAPER_PROXY_URL
MONGO_PORT="${MONGO_PORT:-27018}"
MONGO_ROOT_USER="${MONGO_ROOT_USER:-YOUR_MONGO_USER}"
MONGO_ROOT_PASSWORD="${MONGO_ROOT_PASSWORD:-YOUR_MONGO_PASSWORD}"
MONGO_DB_NAME="${MONGO_DB_NAME:-job_scraper}"
MONGO_COLLECTION_NAME="${MONGO_COLLECTION_NAME:-scrape_runs}"
MONGO_CONTAINER="${MONGO_CONTAINER:-job-scraper-mongo}"
MONGO_VOLUME="${MONGO_VOLUME:-job-scrapper_mongo-data}"
PID_FILE="/tmp/scraper-ssh-socks.pid"
MONGO_PID_FILE="/tmp/scraper-ssh-mongo.pid"
CMD="${1:-status}"

# --- helpers ---

ssh_args() {
  local args=(-o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 -o BatchMode=yes)
  [ -n "$SSH_KEY" ] && args+=(-i "$SSH_KEY")
  echo "${args[@]}"
}

tunnel_pid() {
  [ -f "$PID_FILE" ] || return 1
  local pid
  pid=$(cat "$PID_FILE")
  kill -0 "$pid" 2>/dev/null && echo "$pid"
}

mongo_pid() {
  [ -f "$MONGO_PID_FILE" ] || return 1
  local pid
  pid=$(cat "$MONGO_PID_FILE")
  kill -0 "$pid" 2>/dev/null && echo "$pid"
}

# --- commands ---

cmd_up() {
  if tunnel_pid &>/dev/null; then
    echo "Proxy already up (PID $(tunnel_pid))."
    return 0
  fi

  echo "==> Opening reverse SOCKS proxy: ${SSH_HOST}:${PROXY_PORT} → this machine..."
  # -R with a bare port = reverse dynamic SOCKS: remote :PROXY_PORT tunnels out
  # through this client. Requires OpenSSH client >= 7.6.
  # shellcheck disable=SC2046
  ssh $(ssh_args) \
    -N \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
    -R "${PROXY_PORT}" \
    "${SSH_USER}@${SSH_HOST}" &
  echo $! > "$PID_FILE"
  sleep 1

  if tunnel_pid &>/dev/null; then
    echo "    Proxy up (PID $(cat "$PID_FILE")). Remote scraper → socks5://localhost:${PROXY_PORT}"
  else
    echo "ERROR: proxy process died immediately (forward rejected?)." >&2
    rm -f "$PID_FILE"
    exit 1
  fi
}

cmd_down() {
  local pid
  pid=$(tunnel_pid 2>/dev/null) || { echo "No proxy running."; return 0; }
  echo "==> Closing SOCKS proxy (PID ${pid})..."
  kill "$pid"
  rm -f "$PID_FILE"
  echo "    Done."
}

cmd_mongo_up() {
  if mongo_pid &>/dev/null; then
    echo "Mongo tunnel already up (PID $(mongo_pid))."
    return 0
  fi

  echo "==> Opening mongo forward tunnel: localhost:${MONGO_PORT} → ${SSH_HOST}:27017..."
  # shellcheck disable=SC2046
  ssh $(ssh_args) \
    -N \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
    -L "${MONGO_PORT}:127.0.0.1:27017" \
    "${SSH_USER}@${SSH_HOST}" &
  echo $! > "$MONGO_PID_FILE"
  sleep 1

  if mongo_pid &>/dev/null; then
    echo "    Tunnel up (PID $(cat "$MONGO_PID_FILE")). Connect: mongodb://<user>:<pass>@127.0.0.1:${MONGO_PORT}"
  else
    echo "ERROR: mongo tunnel process died immediately." >&2
    rm -f "$MONGO_PID_FILE"
    exit 1
  fi
}

cmd_mongo_down() {
  local pid
  pid=$(mongo_pid 2>/dev/null) || { echo "No mongo tunnel running."; return 0; }
  echo "==> Closing mongo tunnel (PID ${pid})..."
  kill "$pid"
  rm -f "$MONGO_PID_FILE"
  echo "    Done."
}

cmd_mongo_status() {
  echo "--- mongo forward (-L) ---"
  local pid
  if pid=$(mongo_pid 2>/dev/null); then
    echo "UP   PID=${pid}  localhost:${MONGO_PORT} → ${SSH_HOST}:27017"
  else
    echo "DOWN (run 'mongo-up' to start)"
    rm -f "$MONGO_PID_FILE" 2>/dev/null || true
  fi
}

cmd_mongo_test() {
  if ! mongo_pid &>/dev/null; then
    echo "ERROR: mongo tunnel not running — run 'mongo-up' first." >&2
    exit 1
  fi

  echo "==> Testing mongo tunnel (localhost:${MONGO_PORT})..."

  # bash built-in /dev/tcp — no external `nc` dependency (not installed by default on Manjaro)
  if ! timeout 3 bash -c "exec 3<>/dev/tcp/127.0.0.1/${MONGO_PORT}" 2>/dev/null; then
    echo "    FAIL — port ${MONGO_PORT} not reachable." >&2
    exit 1
  fi
  echo "    Port ${MONGO_PORT} open."

  if command -v mongosh &>/dev/null; then
    local ping_ok
    if [ -z "$MONGO_ROOT_PASSWORD" ]; then
      echo "    WARN — MONGO_ROOT_PASSWORD not set, skipping auth ping."
    # `.ok` prints exactly "1" on success; check value + exit code, not fragile output grep
    elif ping_ok=$(mongosh "mongodb://${MONGO_ROOT_USER}:${MONGO_ROOT_PASSWORD}@127.0.0.1:${MONGO_PORT}/admin" \
          --quiet --eval "db.adminCommand('ping').ok" 2>/dev/null) && [ "$ping_ok" = "1" ]; then
      echo "    OK — mongosh ping succeeded (db=${MONGO_DB_NAME}, collection=${MONGO_COLLECTION_NAME})."
    else
      echo "    WARN — port open but mongosh ping failed (check credentials)."
    fi
  else
    echo "    mongosh not installed — skipping ping check."
  fi
}

# Resets the remote mongo root password to MONGO_ROOT_PASSWORD when the volume
# was initialized with stale creds (MONGO_INITDB_* is ignored on existing
# volumes, so redeploys can't fix this). Runs entirely on the remote host:
# stop authed mongo → temp no-auth mongo on the same volume → set password →
# restart real mongo. trap restarts the real container even if a step fails.
# Creds are passed as positional args (never inlined) and read via process.env
# inside mongosh, so they never sit in a JS string or this file.
cmd_mongo_reset() {
  if [ -z "$MONGO_ROOT_PASSWORD" ]; then
    echo "ERROR: MONGO_ROOT_PASSWORD not set — fill it in this script first." >&2
    exit 1
  fi

  echo "==> Resetting '${MONGO_CONTAINER}' admin password on ${SSH_HOST} (data on ${MONGO_VOLUME} kept)..."
  # shellcheck disable=SC2046
  ssh $(ssh_args) "${SSH_USER}@${SSH_HOST}" \
    bash -s -- "$MONGO_ROOT_USER" "$MONGO_ROOT_PASSWORD" "$MONGO_CONTAINER" "$MONGO_VOLUME" <<'REMOTE'
set -e
RUSER="$1"; RPW="$2"; RCONT="$3"; RVOL="$4"
cleanup() { docker stop mongo-reset >/dev/null 2>&1 || true; docker start "$RCONT" >/dev/null 2>&1 || true; }
trap cleanup EXIT

echo "    1) stopping ${RCONT}..."
docker stop "$RCONT" >/dev/null

echo "    2) starting temp no-auth mongo on ${RVOL}..."
docker run --rm -d --name mongo-reset -v "${RVOL}:/data/db" mongo:7 >/dev/null

echo "    3) waiting for temp mongo..."
for i in $(seq 1 30); do
  docker exec mongo-reset mongosh --quiet --eval 'db.runCommand({ping:1})' >/dev/null 2>&1 && break
  sleep 1
done

echo "    4) setting '${RUSER}' password..."
docker exec -e RUSER="$RUSER" -e RPW="$RPW" mongo-reset mongosh admin --quiet --eval '
  const u = process.env.RUSER, pw = process.env.RPW;
  if (db.getUser(u)) { db.changeUserPassword(u, pw); print("       PWCHANGED"); }
  else { db.createUser({user: u, pwd: pw, roles: [{ role: "root", db: "admin" }]}); print("       PWCREATED"); }
'

echo "    5) stopping temp, restarting ${RCONT}..."
docker stop mongo-reset >/dev/null
docker start "$RCONT" >/dev/null
echo "    DONE-RESET"
REMOTE
}

cmd_status() {
  echo "--- socks proxy (-R) ---"
  local pid
  if pid=$(tunnel_pid 2>/dev/null); then
    echo "UP   PID=${pid}  ${SSH_HOST}:${PROXY_PORT} → this machine"
  else
    echo "DOWN (run 'up' to start)"
    rm -f "$PID_FILE" 2>/dev/null || true
  fi

  echo ""
  echo "--- mongo forward (-L) ---"
  if pid=$(mongo_pid 2>/dev/null); then
    echo "UP   PID=${pid}  localhost:${MONGO_PORT} → ${SSH_HOST}:27017"
  else
    echo "DOWN (run 'mongo-up' to start)"
    rm -f "$MONGO_PID_FILE" 2>/dev/null || true
  fi

  echo ""
  echo "--- remote containers ---"
  # shellcheck disable=SC2046
  ssh $(ssh_args) "${SSH_USER}@${SSH_HOST}" \
    'docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'
}

cmd_test() {
  if ! tunnel_pid &>/dev/null; then
    echo "ERROR: proxy not running — run 'up' first." >&2
    exit 1
  fi

  echo "==> Verifying remote egress through proxy (socks5://localhost:${PROXY_PORT})..."
  local direct proxied
  # shellcheck disable=SC2046
  direct=$(ssh $(ssh_args) "${SSH_USER}@${SSH_HOST}" \
    'curl -s --max-time 15 https://ifconfig.me')
  # shellcheck disable=SC2046
  proxied=$(ssh $(ssh_args) "${SSH_USER}@${SSH_HOST}" \
    "curl -s --socks5-hostname localhost:${PROXY_PORT} --max-time 15 https://ifconfig.me")

  echo "    remote direct egress : ${direct:-<none>}"
  echo "    remote proxied egress: ${proxied:-<none>}"

  if [ -z "$proxied" ]; then
    echo "    FAIL — no response through proxy." >&2
    exit 1
  elif [ "$proxied" = "$direct" ]; then
    echo "    FAIL — proxied egress equals direct egress; traffic is NOT using this machine." >&2
    exit 1
  else
    echo "    OK — remote traffic exits via this machine's IP."
  fi
}

# --- dispatch ---

case "$CMD" in
  up)         cmd_up ;;
  down)       cmd_down ;;
  status)     cmd_status ;;
  test)       cmd_test ;;
  mongo-up)     cmd_mongo_up ;;
  mongo-down)   cmd_mongo_down ;;
  mongo-status) cmd_mongo_status ;;
  mongo-test)   cmd_mongo_test ;;
  mongo-reset)  cmd_mongo_reset ;;
  *)
    echo "Usage: $0 [up|down|status|test|mongo-up|mongo-down|mongo-status|mongo-test|mongo-reset]" >&2
    exit 1
    ;;
esac
