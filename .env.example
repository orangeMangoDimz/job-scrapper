# Local docker-compose env ONLY. Production deploys via GitHub Actions
# (.github/workflows/deploy.yml), which injects secrets/vars with `docker run -e`
# and never reads this file. See docs/deploy.md.
#
# Copy to .env (gitignored) and fill in the values below. These are consumed by
# docker-compose.yml variable interpolation.
#
# NOTE: the legacy personal-bots VPS stack (docs/orchestration.md) uses a
# DIFFERENT env set (CLAUDE_IMAGE, WORKSPACE_DIR, SHM_SIZE, HC_*). For that path,
# copy values from orchestration.md section 4 into the personal-bots .env, not here.

# Discord bot application token. Required for the `bot` profile
# (docker compose --profile bot up). Needs Send Messages perm in the target channel.
DISCORD_BOT_TOKEN=

# Discord channel ID where scrape results are posted. Required for the `bot` profile.
# Enable Discord developer mode, right-click the channel -> Copy ID.
DISCORD_CHANNEL_ID=

BOT_SCHEDULE_ENABLED=true

# SOCKS5/HTTP proxy for scraper-mcp. Required: leave it empty for a direct connection.
# When this line is missing, scrapes stop with an error.
# Example: socks5://host.docker.internal:1080
SCRAPER_PROXY_URL=

# MongoDB root credentials. Required for the `mcp` profile
# (docker compose --profile mcp up: mongo + scraper-mcp services).
# docker-compose.yml derives MONGO_URI from these — do not set MONGO_URI here.
# MONGO_ROOT_PASSWORD has no default; the mongo container fails to start if empty.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=

# Host user for scraper-ui in dev, so it can write output/ui-runs. scripts/run_dev.sh sets
# these for you. Set them here when you start the stack another way, such as scripts/manage.py.
UI_UID=1000
UI_GID=1000
UI_DEV_LOGIN_KEY=

# Prod scraper-ui only. Production values come from GitHub secrets and vars, not this file.
# The UI is optional in prod: the deploy skips it when the UI_DOMAIN variable is not set.
# Make the password hash and put it in the UI_PASSWORD_HASH secret:
#   .venv/bin/python -c "from argon2 import PasswordHasher; import getpass; print(PasswordHasher().hash(getpass.getpass()))"
# Make the session secret and put it in the UI_SESSION_SECRET secret:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If you place the hash in a local .env, wrap it in single quotes, because it contains $.
UI_PASSWORD_HASH=
UI_SESSION_SECRET=
UI_DOMAIN=
# Prod scraper-mcp bind address. Default is the Docker gateway, so bot and scraper-ui
# reach it through host.docker.internal and the public cannot.
MCP_BIND_HOST=172.17.0.1
